[Unit]
Description=noVNC web proxy for display :10
After=vncserver@:10.service
Wants=vncserver@:10.service

[Service]
# Listen port is rewritten at container start from NOVNC_PORT (default 6080).
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 6080 localhost:5910
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
