# Linux user "rocky" password (desktop login + sudo). Change this.
ROCKY_PASSWORD=changeme

# VNC / noVNC password (prompted in the browser). Separate from ROCKY_PASSWORD.
# TigerVNC only uses the first 8 characters.
VNC_PASSWORD=changeme

# noVNC web UI listen port (host network — this is the real bind port, not a map).
# Do not use 5901; that belongs to TigerVNC display :1.
NOVNC_PORT=6080

# Host paths mounted into the container (relative to this compose file)
ROCKY_HOME=./data/home
SHARED_DIR=./data/shared
DOCUMENTS_DIR=./data/documents
DOWNLOADS_DIR=./data/downloads

# Examples — point at real folders on your machine:
# SHARED_DIR=/Users/you/Projects
# DOCUMENTS_DIR=/Users/you/Documents
# DOWNLOADS_DIR=/Users/you/Downloads
# On Windows (Docker Desktop):
# SHARED_DIR=C:/Users/you/Projects
